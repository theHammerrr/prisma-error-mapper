{
  "name": "prisma-error-mapper-express-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:constraints": "prisma db execute --file prisma/constraints.sql --schema prisma/schema.prisma",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:constraints",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "express": "5.1.0",
    "prisma-error-mapper": "file:.."
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.20.4",
    "prisma": "6.14.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
